# ============================================================
# 智汇于庄 H5 · 环境变量示例
#
# 复制为 h5/.env.local（本地开发）或在构建期注入；生产构建请勿设置 VITE_DEMO_MODE。
# ============================================================

# 网关同源相对路径（默认值即为推荐值）
# VITE_API_BASE=/api/v1
# VITE_AI_BASE=/ai/v1

# AI 流式问答（后端开通 /qa/ask/stream 后置 true；当前默认安全回退 JSON）
# VITE_AI_STREAMING_ENABLED=true

# 演示模式：true 时显示「一键填入演示于庄地址」按钮与“演示模式”页脚文案。
# 生产环境必须留空/false —— 避免把演示收货信息当作真实下单数据。
VITE_DEMO_MODE=false
