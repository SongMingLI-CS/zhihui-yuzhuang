# ============================================================
# 智汇于庄 · Nginx 生产接入模板（参数化，经 envsubst 渲染）
#
# 用法：
#   envsubst '${SERVER_NAME} ${TLS_CERT_PATH} ${TLS_KEY_PATH}' \
#     < deploy/nginx/nginx.prod.conf.template > deploy/nginx/nginx.prod.conf
#   并在 docker-compose.prod.yml 中挂载为 /etc/nginx/conf.d/default.conf
#
# 生产安全基线（阶段 A P0-3）：
#   * 仅暴露 80/443；80 全量 301 跳 HTTPS；TLS1.2+ 与现代密码套件；
#   * HSTS / X-Content-Type-Options / X-Frame-Options / Referrer-Policy / CSP；
#   * 登录 / 下单 / AI / 上传 分端点限流；body 限制按端点区分；
#   * Swagger/OpenAPI 与 AI docs 仅内网/管理员网段可访问。
#
# 说明：本文件被 include 进 nginx.conf 的 http 上下文，故 limit_req_zone 合法。
# ============================================================

# ---- 限流区（http 上下文） ----
limit_req_zone $binary_remote_addr zone=rl_login:10m     rate=5r/m;
limit_req_zone $binary_remote_addr zone=rl_checkout:10m  rate=30r/m;
limit_req_zone $binary_remote_addr zone=rl_ai:10m        rate=20r/m;
limit_req_zone $binary_remote_addr zone=rl_upload:10m    rate=10r/m;
limit_conn_zone $binary_remote_addr zone=conn_per_ip:10m;

resolver 127.0.0.11 valid=30s ipv6=off;

# ---- HTTP -> HTTPS ----
server {
    listen 80;
    server_name ${SERVER_NAME};

    # ACME/健康探针保留明文
    location = /healthz {
        default_type text/plain;
        return 200 'ok';
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# ---- HTTPS 主站 ----
server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     ${TLS_CERT_PATH};
    ssl_certificate_key ${TLS_KEY_PATH};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1h;

    # ---- 安全响应头 ----
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'" always;

    limit_conn conn_per_ip 40;
    client_max_body_size 5m;
    server_tokens off;

    # ---- 人工入口页 ----
    location = / {
        default_type text/html;
        return 200 '<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><title>智汇于庄</title></head><body style="font-family:sans-serif;margin:2rem"><h2>智汇于庄 · 统一入口</h2><ul><li><a href="/h5/">消费者端 H5</a></li><li><a href="/b/">管理端（商家/村委/政府/平台）</a></li><li><a href="/healthz">网关存活探针</a></li></ul></body></html>';
    }
    location = /healthz {
        default_type text/plain;
        return 200 'ok';
    }

    # ---- 登录：严格限流 ----
    location = /api/v1/auth/login {
        limit_req zone=rl_login burst=5 nodelay;
        client_max_body_size 64k;
        set $backend_upstream http://backend:8080;
        proxy_pass $backend_upstream;
        include /etc/nginx/conf.d/proxy-common.inc;
    }

    # ---- 下单：限流 + 中等 body ----
    location = /api/v1/orders/checkout {
        limit_req zone=rl_checkout burst=20 nodelay;
        client_max_body_size 256k;
        set $backend_upstream http://backend:8080;
        proxy_pass $backend_upstream;
        include /etc/nginx/conf.d/proxy-common.inc;
    }

    # ---- AI：限流 + 更长超时 ----
    location /ai/ {
        limit_req zone=rl_ai burst=10 nodelay;
        client_max_body_size 12m;
        set $ai_upstream http://ai-service:8000;
        proxy_pass $ai_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # ---- AI 文档 / OpenAPI：仅内网 ----
    location ~ ^/ai/v1/(docs|redoc|openapi.json)$ {
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
        set $ai_upstream http://ai-service:8000;
        proxy_pass $ai_upstream;
    }

    # ---- 上传：限流（知识文档 / 商品图片） ----
    location ~ ^/(ai/v1/knowledge/docs/upload|api/v1/merchant/media) {
        limit_req zone=rl_upload burst=5 nodelay;
        client_max_body_size 12m;
        set $backend_upstream http://backend:8080;
        proxy_pass $backend_upstream;
        include /etc/nginx/conf.d/proxy-common.inc;
    }

    # ---- 业务 API ----
    location /api/ {
        client_max_body_size 2m;
        set $backend_upstream http://backend:8080;
        proxy_pass $backend_upstream;
        include /etc/nginx/conf.d/proxy-common.inc;
    }

    # ---- Swagger / OpenAPI：仅内网/运维网段 ----
    location ~ ^/(swagger-ui|v3/api-docs) {
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
        set $backend_upstream http://backend:8080;
        proxy_pass $backend_upstream;
    }

    # ---- B 端管理端 ----
    location /b/ {
        client_max_body_size 2m;
        set $web_upstream http://web:3000;
        proxy_pass $web_upstream;
        include /etc/nginx/conf.d/proxy-common.inc;
    }

    # ---- C 端 H5 ----
    location /h5/ {
        client_max_body_size 2m;
        set $h5_upstream http://h5:80;
        proxy_pass $h5_upstream;
        include /etc/nginx/conf.d/proxy-common.inc;
    }

    location / {
        default_type text/html;
        return 404 '<!doctype html><html lang="zh-CN"><body style="font-family:sans-serif;margin:2rem"><h3>404 · 未知路由</h3></body></html>';
    }
}
