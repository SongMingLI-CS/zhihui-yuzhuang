# ============ 智汇于庄 · 环境变量示例 ============
# 复制为 .env 后按需修改（.env 已被 gitignore，不会提交）。
# 用法：docker compose --env-file .env -f deploy/docker-compose.yml up -d

# --- PostgreSQL ---
POSTGRES_DB=rural_revitalization
POSTGRES_USER=rural_user
POSTGRES_PASSWORD=rural_password
# 宿主机映射端口（容器内 5432；默认 5433 与 deploy/docker-compose.yml 对齐）
POSTGRES_PORT=5433

# --- Redis ---
REDIS_PORT=6379

# --- Nginx 网关 ---
GATEWAY_PORT=80

# --- 运行环境与演示开关（阶段 A）---
# APP_ENV=production 时：禁止演示账号/灌数/默认密钥（缺失高熵 AUTH_JWT_SECRET 直接启动失败）
APP_ENV=demo
DEMO_MODE=true
# 与 backend/ai-service 共用的 JWT 密钥；生产必须替换为高熵值（openssl rand -base64 48）
AUTH_JWT_SECRET=yuzhuang-demo-jwt-secret-0123456789abcdef
# 生产 HTTPS 下必须为 true
AUTH_SESSION_COOKIE_SECURE=false

# --- AI 服务（后续阶段启用） ---
# DEEPSEEK_API_KEY=sk-xxxx

# --- 时区 ---
TZ=Asia/Shanghai
