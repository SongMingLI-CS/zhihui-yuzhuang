# ============ 智汇于庄 · 生产环境变量模板 ============
# 复制为 .env.production 后填写；该文件已被 gitignore，切勿提交仓库或打入镜像/前端 bundle。
# 用法：docker compose --env-file .env.production -f deploy/docker-compose.prod.yml up -d --build

# --- 域名与端口（必须配置）---
SERVER_NAME=example.gov.cn
HTTP_PORT=80
HTTPS_PORT=443
# TLS 证书目录（含 fullchain.pem / privkey.pem）
TLS_DIR=/etc/letsencrypt/live/example.gov.cn

# --- PostgreSQL（必须为高熵口令；生产不映射宿主端口）---
POSTGRES_DB=rural_revitalization
POSTGRES_USER=rural_user
POSTGRES_PASSWORD=请替换为高熵口令

# --- 认证密钥（必须 ≥32 字符高熵；backend 缺失即拒绝启动）---
# 生成示例：openssl rand -base64 48
AUTH_JWT_SECRET=请替换为高熵密钥至少32字符
AUTH_JWT_EXPIRE_MINUTES=120

# --- AI 能力（可选：不提供时 AI 功能在生产明确不可用，不会伪造成功）---
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# --- 支付（可选：不提供时生产禁用支付，不模拟成功）---
# PAYMENT_PROVIDER=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_API_V3_KEY=
# ALIPAY_APP_ID=

# --- 对象存储（可选：本地/演示用 MinIO；生产用 S3/COS/OSS）---
# MEDIA_STORAGE=s3
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_BUCKET=
# MEDIA_S3_ACCESS_KEY=
# MEDIA_S3_SECRET_KEY=

# --- 时区 ---
TZ=Asia/Shanghai
