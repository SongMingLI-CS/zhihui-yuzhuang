# ============================================================
# 智汇于庄 backend · 环境变量示例
# 本地开发：复制为 backend/.env 并按需修改，
#   source backend/.env && mvn -f backend/pom.xml spring-boot:run
# 说明：
#   - dev profile 面向宿主机本地开发（localhost:5433，见 application-dev.yml）
#   - 容器内运行时请勿激活 dev，直接以主配置默认值
#     （rural-revitalization-postgres:5432，Docker 网络）为准。
# ============================================================

# --- Spring ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- PostgreSQL ---
# dev 默认 localhost:5433（宿主映射端口）；容器内由主配置默认即可
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=rural_revitalization
POSTGRES_USER=rural_user
POSTGRES_PASSWORD=rural_password

# --- HikariCP（可选） ---
# DB_POOL_MAX_SIZE=20
# DB_POOL_MIN_IDLE=5
