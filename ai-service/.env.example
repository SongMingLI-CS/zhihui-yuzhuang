# ============ ai-service · 环境变量示例 ============
# 复制为 ai-service/.env 后按需修改（.env 已被 gitignore，不会提交）。
#
# 环境变量契约与 deploy/docker-compose.yml 中 ai-service 服务保持一致：
#   DATABASE_URL / DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / EMBEDDING_*
#
# 本地开发默认连接 docker compose 发布到宿主机的 PostgreSQL(pgvector)：
#   host=localhost:5432  db=rural_revitalization  user=rural_user  pwd=rural_password
# 容器内请将 host 替换为内网服务名：postgres（即 rural-revitalization-postgres）。

# --- PostgreSQL / pgvector ---
DATABASE_URL=postgresql://rural_user:rural_password@localhost:5432/rural_revitalization

# 连接池（可选）
# DB_POOL_MIN_SIZE=2
# DB_POOL_MAX_SIZE=10

# --- DeepSeek (LLM，对话/生成) ---
# DEEPSEEK_API_KEY=sk-xxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Embedding（与 LLM 端点解耦，兼容 OpenAI 规范）---
# DeepSeek 暂无官方 Embedding API，故向量化走独立配置（EMBEDDING_*）。
# EMBEDDING_API_KEY 为空时自动回退使用 DEEPSEEK_API_KEY；
# 两者都为空时，Embedder 进入 Mock 模式（确定性伪随机向量，可离线联调）。
# EMBEDDING_API_KEY=sk-xxxx
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
