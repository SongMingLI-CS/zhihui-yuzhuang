# ============================================================
# 智汇于庄 · ai-service 环境变量示例（自配置 API Key 的唯一入口）
#
# 用法（任选其一）：
#   1) 复制本文件为 ai-service/.env 后填写（本地开发/单机部署推荐）
#        cp ai-service/.env.example ai-service/.env
#   2) 通过容器环境变量注入（Docker Compose / K8s Secret），见 deploy/*.yml
#   3) 在服务器上以 export DEEPSEEK_API_KEY=... 方式注入后再启动进程
#
# 安全约定：
#   - 本文件不含任何真实密钥；.env 已被 .gitignore 忽略，切勿提交仓库或打进镜像；
#   - 不要在代码、前端 bundle、Nginx 配置中硬编码密钥；
#   - 配置完成后用 GET /ai/v1/capabilities（需登录）查看“是否已配置/是否可用”，
#     该接口只返回 bool/模型名/降级标识，绝不回显密钥。
# ============================================================

# ---- 运行环境 ----
# production / prod 为生产；dev / local / demo 为非生产。
APP_ENV=dev
# 演示开关：仅 DEMO_MODE=true（或非生产）才允许伪随机 Embedding 与离线营销模板。
# 生产环境 DEMO_MODE=false 且未配置密钥时，AI 能力被判定为“不可用”，不会伪造成功。
DEMO_MODE=false

# ---- 身份校验（必须与 backend 的 AUTH_JWT_SECRET 完全一致）----
# 生成示例：openssl rand -base64 48
AUTH_JWT_SECRET=

# ---- PostgreSQL / pgvector ----
# 本地默认连接 compose 映射到宿主机的 5432；若 compose 映射为 5433 请改为 5433。
# 容器内请将 host 替换为内网服务名：postgres（即 rural-revitalization-postgres）。
DATABASE_URL=postgresql://rural_user:rural_password@localhost:5432/rural_revitalization

# 连接池（可选）
# DB_POOL_MIN_SIZE=2
# DB_POOL_MAX_SIZE=10

# ---- DeepSeek（LLM：农技问答生成 + 营销文案）----
# 在此填入你自己的 API Key；不配置时：非生产走离线模板（明确标注 Mock），
# 生产则 readiness 不通过、相关接口返回“不可用”而非伪装结果。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Embedding（向量检索；OpenAI 兼容端点，DeepSeek 无官方 Embedding）----
# 留空时回退使用 DEEPSEEK_API_KEY；两者都为空时按 DEMO_MODE / 环境判定 Mock 或不可用。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# 向量维度必须与建表时一致（改维度需重建 t_knowledge_chunk）
EMBEDDING_DIM=1536

# ---- RAG 检索 ----
RAG_HYBRID_ENABLED=true
RAG_KEYWORD_MIN_SCORE=0.3

